# ==========================================
# Gauswarn India — Apache Configuration
# Last updated: 2026-05-13
# ==========================================

Options -MultiViews
RewriteEngine On

# ==========================================
# 1. Redirect www to non-www (PRIMARY FIX)
# Resolves: "Page with redirect" GSC issue
# ==========================================
RewriteCond %{HTTP_HOST} ^www\.gauswarn\.com [NC]
RewriteRule ^(.*)$ https://gauswarn.com/$1 [R=301,L]

# ==========================================
# 2. Force HTTPS
# ==========================================
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# ==========================================
# 3. Redirect old/thin pages to prevent "Crawled - currently not indexed"
# ==========================================
RewriteRule ^track/?$ https://gauswarn.com/ [R=301,L]
RewriteRule ^singleproduct/?$ https://gauswarn.com/products/ [R=301,L]

# ==========================================
# 4. Add trailing slash to all routes (PRIMARY FIX)
# Resolves: "Alternate page with proper canonical tag" GSC issue
# Skips: files with extensions, /api/, already ending in /
# ==========================================
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !/$
RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]+$
RewriteCond %{REQUEST_URI} !^/api/
RewriteRule ^(.*)$ /$1/ [R=301,L]

# ==========================================
# 5. 301 redirect old query-param product URLs → SEO slug URLs
# Resolves: Merchant Center "cannot crawl product landing page"
# ==========================================
RewriteCond %{QUERY_STRING} ^v=5$
RewriteRule ^products/?$ /products/a2-bilona-ghee-250ml/? [R=301,L]

RewriteCond %{QUERY_STRING} ^v=1$
RewriteRule ^products/?$ /products/a2-bilona-ghee-500ml/? [R=301,L]

RewriteCond %{QUERY_STRING} ^v=2$
RewriteRule ^products/?$ /products/a2-bilona-ghee-1000ml/? [R=301,L]

RewriteCond %{QUERY_STRING} ^v=3$
RewriteRule ^products/?$ /products/a2-bilona-ghee-5kg/? [R=301,L]

RewriteCond %{QUERY_STRING} ^v=4$
RewriteRule ^products/?$ /products/a2-bilona-ghee-15kg/? [R=301,L]

# Catch-all: any other ?v= param redirects to /products/
RewriteCond %{QUERY_STRING} ^v=
RewriteRule ^products/?$ /products/? [R=301,L]

# ==========================================
# 6. React SPA Fallback (must be last)
# Serves index.html for all routes that don't match files/dirs
# ==========================================
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ /index.html [L]

# ==========================================
# 7. Security Headers
# ==========================================
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# ==========================================
# 8. Cache Control
# ==========================================
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# ==========================================
# 9. Compression
# ==========================================
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml application/xml
  AddOutputFilterByType DEFLATE font/woff2
</IfModule>
